Sub Process_Globals
    Private ApiKeyJsonPath As String = "C:\tools\google-key.json" ' Path to your Service Account JSON file
    Private PackageName As String = "com.example.myapp"
    Private AabFilePath As String
    Private AccessToken As String
    Private TokenExpiryTime As Long
End Sub

