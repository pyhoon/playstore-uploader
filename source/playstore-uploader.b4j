#Region Macros
#Macro: Title, Build only, ide://run?File=%B4X%\B4JBuilder.exe&Args=-Task%3DBuild&Args=-BaseFolder%3D..&Args=-Obfuscate=False&Args=-Output%3Daabtool
#Macro: Title, Release Folder, ide://run?File=%WINDIR%\SysWOW64\explorer.exe&Args=%PROJECT%\..\release
#Macro: Title, Copy to AddLibs, ide://run?File=%COMSPEC%&Args=/c&Args=copy&Args=%PROJECT%\..\release\%PROJECT_NAME%.b4xlib&Args=%ADDITIONAL%\..\B4X
#If Release
#CustomBuildAction: 2, %COMSPEC%, /c copy %PROJECT%\Objects\playstore-uploader.jar %ADDITIONAL%\aabtool.jar
#End If
#End Region
'Put this inside B4A project Main
'#CustomBuildAction: 5, %COMSPEC%, /c java -jar "C:\tools\aabtool.jar" app-bundle-upload --application-name "Your App Name" --application-package "com.your.package" --app-bundle "%PROJECT%\your_app.aab" --secret-file "C:\tools\google-key.json"
'#CustomBuildAction: 5, %COMSPEC%, /c gpc releases upload "PROJECT%\your_app.aab" --track internal
Sub Process_Globals

End Sub

Sub AppStart (Args() As String)
	Log("aabtool (v0.10) started...")
	If Args.Length = 0 Then
		Log("Error: UploadTool's path not provided")
		Log("aabtool ended")
		ExitApplication
	End If
	Dim ScriptPath As String = Args(0)
	Dim AAB_Name As String = "aab_name.aab"
	If Args.Length > 1 Then
		AAB_Name = Args(1)
		Log("AAB_Name=" & AAB_Name)
	End If
	RunUploadProcess(ScriptPath, "%PROJECT%", AAB_Name)
	StartMessageLoop
End Sub

Sub RunUploadProcess (UploadLink As String, FilePath As String, FileName As String)
	If Not(File.Exists(FilePath, FileName)) Then
		Log("Error: " & FilePath & "\" & FileName & " not found.")
		Log("aabtool aborted")
		ExitApplication
	End If
	Upload(UploadLink, FilePath, FileName)
End Sub

Sub Upload (UploadLink As String, FileDirectory As String, FileName As String) As ResumableSub
	Log($"Uploading ${FileName}..."$)
	Try
		Dim success As Boolean
		Dim job As HttpJob
		job.Initialize
		job.PostFile(UploadLink, FileDirectory, FileName)
		Wait For (job) JobDone(job As HttpJob)
		If job.Success Then
			Dim out As OutputStream = File.OpenOutput(FileDirectory, FileName, False)
			File.Copy2(job.GetInputStream, out)
			out.Close
			Log($"${FileName} downloaded"$)
			success = True
		Else
			Log(job.ErrorMessage)
		End If
	Catch
		Log(LastException.Message)
	End Try
	job.Release
	Return success
End Sub