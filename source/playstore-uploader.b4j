AppType=StandardJava
Build1=Default,b4j.example
Group=App
Library1=javaobject
Library2=jcore
Library3=jokhttputils2
Library4=json
NumberOfFiles=0
NumberOfLibraries=4
NumberOfModules=0
Version=10.7
@EndOfDesignText@
#Region Project Attributes 
' Product: AppBundle Uploader for B4A
' Version: 0.11
' License: MIT License
' Developer: Poon Yip Hoon (Aeric)
#CommandLineArgs:
#MergeLibraries: True
#End Region
#Region Macros
#Macro: Title, Build only, ide://run?File=%B4X%\B4JBuilder.exe&Args=-Task%3DBuild&Args=-BaseFolder%3D..&Args=-Obfuscate=False&Args=-Output%3Daabtool
#Macro: Title, Release Folder, ide://run?File=%WINDIR%\SysWOW64\explorer.exe&Args=%PROJECT%\..\release
#Macro: Title, Copy to AddLibs, ide://run?File=%COMSPEC%&Args=/c&Args=copy&Args=%PROJECT%\..\release\%PROJECT_NAME%.b4xlib&Args=%ADDITIONAL%\..\B4X
#If Release
#CustomBuildAction: 2, %COMSPEC%, /c copy %PROJECT%\Objects\playstore-uploader.jar %ADDITIONAL%\aabtool.jar
#End If
#End Region
Sub Process_Globals
	Private Const TokenUrl As String = "https://oauth2.googleapis.com/token"
	Private Const ApiBase As String = "https://androidpublisher.googleapis.com/androidpublisher/v3"
	Private Const UploadBase As String = "https://androidpublisher.googleapis.com/upload/androidpublisher/v3"
	Private Const AuthScope As String = "https://www.googleapis.com/auth/androidpublisher"

	Private ApiKeyJsonPath As String = "C:\tools\google-key.json"
	Private PackageName As String = ""
	Private AabFilePath As String = ""
	Private ApplicationName As String = ""
	Private TrackName As String = ""
	Private ReleaseStatus As String = "completed"
	Private AccessToken As String
	Private CurrentEditId As String
End Sub

Sub AppStart (Args() As String)
	Log("aabtool (v0.11) started...")
	If ParseArgs(Args) = False Then
		LogUsage
		ExitApplication
		Return
	End If
	If File.Exists("", AabFilePath) = False Then
		Log("Error: App Bundle not found: " & AabFilePath)
		ExitApplication
		Return
	End If
	If File.Exists("", ApiKeyJsonPath) = False Then
		Log("Error: Service account JSON not found: " & ApiKeyJsonPath)
		ExitApplication
		Return
	End If
	If ApplicationName <> "" Then Log("Application: " & ApplicationName)
	RunUpload
	StartMessageLoop
End Sub

Sub ParseArgs (Args() As String) As Boolean
	Dim i As Int = 0
	Do While i < Args.Length
		Dim Arg As String = Args(i)
		Dim LowerArg As String = Arg.ToLowerCase
		Select LowerArg
			Case "app-bundle-upload", "--app-bundle-upload"
				Log("Command: app-bundle-upload")
			Case "--app-bundle", "--aab"
				i = i + 1
				If i >= Args.Length Then Return False
				AabFilePath = Args(i)
			Case "--application-package", "--package"
				i = i + 1
				If i >= Args.Length Then Return False
				PackageName = Args(i)
			Case "--application-name"
				i = i + 1
				If i >= Args.Length Then Return False
				ApplicationName = Args(i)
			Case "--secret-file", "--key"
				i = i + 1
				If i >= Args.Length Then Return False
				ApiKeyJsonPath = Args(i)
			Case "--track"
				i = i + 1
				If i >= Args.Length Then Return False
				TrackName = Args(i)
			Case "--status"
				i = i + 1
				If i >= Args.Length Then Return False
				ReleaseStatus = Args(i)
			Case Else
				If LowerArg.StartsWith("--") Then
					Log("Error: Unknown option: " & Arg)
					Return False
				End If
				If AabFilePath = "" Then
					AabFilePath = Arg
				Else If PackageName = "" Then
					PackageName = Arg
				Else If File.Exists("", Arg) Then
					ApiKeyJsonPath = Arg
				Else
					Log("Error: Unexpected argument: " & Arg)
					Return False
				End If
		End Select
		i = i + 1
	Loop
	If AabFilePath = "" Or PackageName = "" Then
		Log("Error: Both the App Bundle path and the application package are required.")
		Return False
	End If
	Return True
End Sub

Sub LogUsage
	Log("Usage:")
	Log("  java -jar aabtool.jar --app-bundle <file.aab> --application-package <package> [--secret-file <key.json>] [--track <track>] [--status <status>]")
	Log("  java -jar aabtool.jar <file.aab> <package> [key.json]")
	Log("Options:")
	Log("  --track    Optional track name, for example: internal, alpha, beta, production.")
	Log("  --status   Release status for the track. Default: completed.")
End Sub

Sub RunUpload As ResumableSub
	Log("Package: " & PackageName)
	Log("Bundle: " & AabFilePath)
	If TrackName <> "" Then Log("Track: " & TrackName & " (" & ReleaseStatus & ")")

	Dim Assertion As String = BuildJwtAssertion
	If Assertion = "" Then
		Log("Error: Failed to build the OAuth2 assertion.")
		Finish(False)
		Return False
	End If

	Log("Requesting access token...")
	Dim TokenJob As HttpJob
	TokenJob.Initialize("GetToken", Me)
	TokenJob.PostString(TokenUrl, "grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer&assertion=" & Assertion)
	TokenJob.GetRequest.SetContentType("application/x-www-form-urlencoded")
	Wait For (TokenJob) JobDone (TokenJob As HttpJob)
	If TokenJob.Success = False Then
		LogJobError(TokenJob, "token exchange")
		TokenJob.Release
		Finish(False)
		Return False
	End If
	Dim TokenMap As Map = ParseJson(TokenJob.GetString)
	TokenJob.Release
	AccessToken = MapGet(TokenMap, "access_token")
	If AccessToken = "" Then
		Log("Error: The token response did not include an access_token.")
		Finish(False)
		Return False
	End If
	Log("Access token acquired.")

	Log("Creating edit session...")
	Dim EditJob As HttpJob
	EditJob.Initialize("CreateEdit", Me)
	EditJob.PostString(ApiBase & "/applications/" & PackageName & "/edits", "{}")
	EditJob.GetRequest.SetContentType("application/json")
	EditJob.GetRequest.SetHeader("Authorization", "Bearer " & AccessToken)
	Wait For (EditJob) JobDone (EditJob As HttpJob)
	If EditJob.Success = False Then
		LogJobError(EditJob, "create edit")
		EditJob.Release
		Finish(False)
		Return False
	End If
	Dim EditMap As Map = ParseJson(EditJob.GetString)
	EditJob.Release
	CurrentEditId = MapGet(EditMap, "id")
	If CurrentEditId = "" Then
		Log("Error: The edit response did not include an id.")
		Finish(False)
		Return False
	End If
	Log("Edit session: " & CurrentEditId)

	Log("Uploading App Bundle...")
	Dim UploadJob As HttpJob
	UploadJob.Initialize("UploadBundle", Me)
	Dim UploadUrl As String = UploadBase & "/applications/" & PackageName & "/edits/" & CurrentEditId & "/bundles?uploadType=media"
	UploadJob.PostFile(UploadUrl, File.GetFileParent(AabFilePath), File.GetName(AabFilePath))
	UploadJob.GetRequest.SetContentType("application/octet-stream")
	UploadJob.GetRequest.SetHeader("Authorization", "Bearer " & AccessToken)
	Wait For (UploadJob) JobDone (UploadJob As HttpJob)
	If UploadJob.Success = False Then
		LogJobError(UploadJob, "bundle upload")
		UploadJob.Release
		Wait For (AbortEdit) Complete (Ignored As Boolean)
		Finish(False)
		Return False
	End If
	Dim UploadMap As Map = ParseJson(UploadJob.GetString)
	UploadJob.Release
	Dim VersionCode As Long = 0
	If UploadMap.ContainsKey("versionCode") Then VersionCode = UploadMap.Get("versionCode")
	If VersionCode <= 0 Then
		Log("Error: The upload response did not include a versionCode.")
		Wait For (AbortEdit) Complete (Ignored As Boolean)
		Finish(False)
		Return False
	End If
	Log("Uploaded version code: " & VersionCode)

	If TrackName <> "" Then
		Log("Assigning version code " & VersionCode & " to track " & TrackName & "...")
		Dim ReleaseMap As Map = CreateMap("status": ReleaseStatus, "versionCodes": Array(VersionCode))
		Dim TrackBody As Map = CreateMap("releases": Array(ReleaseMap))
		Dim TrackJson As JSONGenerator
		TrackJson.Initialize(TrackBody)
		Dim TrackJob As HttpJob
		TrackJob.Initialize("UpdateTrack", Me)
		TrackJob.PutString(ApiBase & "/applications/" & PackageName & "/edits/" & CurrentEditId & "/tracks/" & TrackName, TrackJson.ToString)
		TrackJob.GetRequest.SetContentType("application/json")
		TrackJob.GetRequest.SetHeader("Authorization", "Bearer " & AccessToken)
		Wait For (TrackJob) JobDone (TrackJob As HttpJob)
		If TrackJob.Success = False Then
			LogJobError(TrackJob, "track update")
			TrackJob.Release
			Wait For (AbortEdit) Complete (Ignored As Boolean)
			Finish(False)
			Return False
		End If
		TrackJob.Release
	End If

	Log("Committing edit...")
	Dim CommitJob As HttpJob
	CommitJob.Initialize("CommitEdit", Me)
	CommitJob.PostString(ApiBase & "/applications/" & PackageName & "/edits/" & CurrentEditId & ":commit", "{}")
	CommitJob.GetRequest.SetContentType("application/json")
	CommitJob.GetRequest.SetHeader("Authorization", "Bearer " & AccessToken)
	Wait For (CommitJob) JobDone (CommitJob As HttpJob)
	If CommitJob.Success = False Then
		LogJobError(CommitJob, "commit edit")
		CommitJob.Release
		Wait For (AbortEdit) Complete (Ignored As Boolean)
		Finish(False)
		Return False
	End If
	CommitJob.Release
	CurrentEditId = ""
	Finish(True)
	Return True
End Sub

Sub AbortEdit As ResumableSub
	If CurrentEditId = "" Then Return False
	Log("Aborting edit " & CurrentEditId & "...")
	Dim AbortJob As HttpJob
	AbortJob.Initialize("AbortEdit", Me)
	AbortJob.Delete(ApiBase & "/applications/" & PackageName & "/edits/" & CurrentEditId)
	AbortJob.GetRequest.SetHeader("Authorization", "Bearer " & AccessToken)
	Wait For (AbortJob) JobDone (AbortJob As HttpJob)
	If AbortJob.Success = False Then LogJobError(AbortJob, "abort edit")
	AbortJob.Release
	CurrentEditId = ""
	Return True
End Sub

Sub Finish (Success As Boolean)
	If Success Then
		Log("Done: App Bundle uploaded and edit committed.")
	Else
		Log("Done: upload failed.")
	End If
	ExitApplication
End Sub

Sub BuildJwtAssertion As String
	Try
		Dim Parser As JSONParser
		Parser.Initialize(File.ReadString("", ApiKeyJsonPath))
		Dim KeyMap As Map = Parser.NextObject
		Dim ClientEmail As String = MapGet(KeyMap, "client_email")
		Dim PrivateKeyPem As String = MapGet(KeyMap, "private_key")
		If ClientEmail = "" Or PrivateKeyPem = "" Then
			Log("Error: Service account JSON must contain client_email and private_key.")
			Return ""
		End If

		Dim NowSeconds As Long = DateTime.Now / 1000
		Dim HeaderJson As JSONGenerator
		HeaderJson.Initialize(CreateMap("alg": "RS256", "typ": "JWT"))
		Dim PayloadJson As JSONGenerator
		PayloadJson.Initialize(CreateMap( _
			"iss": ClientEmail, _
			"scope": AuthScope, _
			"aud": TokenUrl, _
			"iat": NowSeconds, _
			"exp": NowSeconds + 3600))

		Dim SigningInput As String = Base64Url(HeaderJson.ToString.GetBytes("UTF8")) & "." & Base64Url(PayloadJson.ToString.GetBytes("UTF8"))
		Dim Signature() As Byte = SignData(SigningInput.GetBytes("UTF8"), PrivateKeyPem)
		If Signature.Length = 0 Then Return ""
		Return SigningInput & "." & Base64Url(Signature)
	Catch
		Log("Error: Failed to build JWT: " & LastException.Message)
		Return ""
	End Try
End Sub

Sub SignData (Data() As Byte, PrivateKeyPem As String) As Byte()
	Dim su As StringUtils
	Dim Pem As String = PrivateKeyPem _
		.Replace("-----BEGIN PRIVATE KEY-----", "") _
		.Replace("-----END PRIVATE KEY-----", "") _
		.Replace(Chr(13), "") _
		.Replace(Chr(10), "") _
		.Replace(" ", "") _
		.Replace(Chr(9), "")
	Dim KeyBytes() As Byte = su.DecodeBase64(Pem)

	Dim Spec As JavaObject
	Spec.InitializeNewInstance("java.security.spec.PKCS8EncodedKeySpec", Array(KeyBytes))

	Dim KeyFactoryClass As JavaObject
	KeyFactoryClass.InitializeStatic("java.security.KeyFactory")
	Dim KeyFactory As JavaObject = KeyFactoryClass.RunMethod("getInstance", Array("RSA"))
	Dim PrivateKey As Object = KeyFactory.RunMethod("generatePrivate", Array(Spec))

	Dim SignatureClass As JavaObject
	SignatureClass.InitializeStatic("java.security.Signature")
	Dim Signer As JavaObject = SignatureClass.RunMethod("getInstance", Array("SHA256withRSA"))
	Signer.RunMethod("initSign", Array(PrivateKey))
	Signer.RunMethod("update", Array(Data))
	Dim Result() As Byte = Signer.RunMethod("sign", Null)
	Return Result
End Sub

Sub Base64Url (Data() As Byte) As String
	Dim su As StringUtils
	Return su.EncodeBase64(Data).Replace("+", "-").Replace("/", "_").Replace("=", "")
End Sub

Sub ParseJson (Text As String) As Map
	Try
		Dim Parser As JSONParser
		Parser.Initialize(Text)
		Return Parser.NextObject
	Catch
		Log("Error: Could not parse JSON response: " & LastException.Message)
		Return CreateMap()
	End Try
End Sub

Sub MapGet (Values As Map, Key As String) As String
	If Values = Null Or Values.ContainsKey(Key) = False Then Return ""
	Dim Value As Object = Values.Get(Key)
	If Value = Null Then Return ""
	Return "" & Value
End Sub

Sub LogJobError (Job As HttpJob, Stage As String)
	Log("Error during " & Stage & ": " & Job.ErrorMessage)
End Sub
