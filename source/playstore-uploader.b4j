Sub AppStart (Args() As String)
	Log("aabtool (v0.10) started...")
    If Args.Length < 2 Then
        Log("Usage: java -jar aabtool.jar <path_to_aab> <package_name>")
        ExitApplication
    End If
    
    AabFilePath = Args(0)
    PackageName = Args(1)
    
    ' Start the flow by fetching an OAuth token
    FetchOAuth2Token
    StartMessageLoop
End Sub

' Call this routine as the first step in AppStart
Sub FetchOAuth2Token
	Log("Parsing Service Account JSON Key...")
	If File.Exists("", ApiKeyJsonPath) = False Then
		Log("Error: JSON Key file not found at " & ApiKeyJsonPath)
		ExitApplication
	End If
    
	Dim parser As JSONParser
	parser.Initialize(File.ReadString("", ApiKeyJsonPath))
	Dim keyMap As Map = parser.NextObject
	
	Dim ClientEmail As String = keyMap.Get("client_email")
	Dim PrivateKeyPem As String = keyMap.Get("private_key")
    
	' 1. Prepare JWT Claims Header and Payload
	Dim su As StringUtils
	Dim CurrentTimeSec As Long = DateTime.Now / 1000
	Dim ExpiryTimeSec As Long = CurrentTimeSec + 3600
    
	Dim HeaderMap As Map = CreateMap("alg": "RS256", "typ": "JWT")
	Dim PayloadMap As Map = CreateMap( _
        "iss": ClientEmail, _
        "scope": "https://googleapis.com", _
        "aud": "https://googleapis.com", _
        "exp": ExpiryTimeSec, _
        "iat": CurrentTimeSec _
    )
    
	
	Dim json As JSONGenerator
	json.Initialize(HeaderMap)
	Dim HeaderBase64 As String = su.EncodeBase64(json.ToString.GetBytes("UTF8")).Replace("=", "").Replace("/", "_").Replace("+", "-")
    
	json.Initialize(PayloadMap)
	Dim PayloadBase64 As String = su.EncodeBase64(json.ToString.GetBytes("UTF8")).Replace("=", "").Replace("/", "_").Replace("+", "-")
    
	Dim SignatureInput As String = HeaderBase64 & "." & PayloadBase64
    
	' 2. Sign the input using RS256 with Native Java mapping
	Log("Signing JWT Signature assertion...")
	Dim NativeSigner As JavaObject
	NativeSigner.InitializeStatic("com.google.auth.SignerHelper") ' Refers to our inline Java class below
    
	Dim SignatureBytes() As Byte = NativeSigner.RunMethod("signData", Array(SignatureInput.GetBytes("UTF8"), PrivateKeyPem))
	Dim SignatureBase64 As String = su.EncodeBase64(SignatureBytes).Replace("=", "").Replace("/", "_").Replace("+", "-")
    
	Dim AssertionToken As String = SignatureInput & "." & SignatureBase64
    
	' 3. Exchange Signed JWT assertion for a temporary access token via API
	Log("Exchanging assertion payload for an access token...")
	Dim job As HttpJob
	job.Initialize("GetToken", Me)
	job.PostString("https://googleapis.com", $"grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer&assertion=${AssertionToken}"$)
	job.GetRequest.SetContentType("application/x-www-form-urlencoded")
	Wait For (job) JobDone (job As HttpJob)
	If job.Success Then
		'assuming that the response is json:
		Dim root As Map = job.GetString.As(JSON).ToMap
		Log(root)

        Dim parser As JSONParser
        parser.Initialize(job.GetString)
        Dim root As Map = parser.NextObject
        
        Select job.JobName
            Case "GetToken"
                AccessToken = root.Get("access_token")
                Log("Authentication Successful! Token acquired.")
                ' Transition immediately to create the Edit Draft now that we are validated
                CreateEditDraft
                
            Case "CreateEdit"
                Dim EditId As String = root.Get("id")
                UploadAAB(EditId)
                
            Case "UploadBundle"
                Dim EditId As String = job.Tag 
                CommitChanges(EditId)
                
            Case "CommitEdit"
                Log("Success! AAB published successfully to Google Play via B4J.")
                StopMessageLoop
                ExitApplication
        End Select
    Else
        Log("Error occurred during job [" & job.JobName & "]: " & job.ErrorMessage)
        StopMessageLoop
        ExitApplication
    End If
    job.Release

End Sub

#If JAVA
import java.security.KeyFactory;
import java.security.PrivateKey;
import java.security.Signature;
import java.security.spec.PKCS8EncodedKeySpec;
import java.util.Base64;

public class SignerHelper {
    public static byte[] signData(byte[] data, String privateKeyPem) throws Exception {
        // Strip down PEM framing formatting metadata
        String privateKeyKey = privateKeyPem
                .replace("-----BEGIN PRIVATE KEY-----", "")
                .replaceAll(System.lineSeparator(), "")
                .replace("-----END PRIVATE KEY-----", "")
                .replaceAll("\\s", "");

        byte[] encoded = Base64.getDecoder().decode(privateKeyKey);
        PKCS8EncodedKeySpec keySpec = new PKCS8EncodedKeySpec(encoded);
        KeyFactory kf = KeyFactory.getInstance("RSA");
        PrivateKey privKey = kf.generatePrivate(keySpec);

        Signature privateSignature = Signature.getInstance("SHA256withRSA");
        privateSignature.initSign(privKey);
        privateSignature.update(data);

        return privateSignature.sign();
    }
}
#End If


' 1. Authenticate with Google
'Sub FetchOAuth2Token
'    ' Note: For production, use GoogleOAuth2 or a JWT generator library.
'    ' This acts as the entry point to communicate with the REST API.
'    Log("Authenticating with Google API...")
'    
'    ' Pro-Tip: To keep your B4J code pure and simple, you can use standard 
'    ' OAuth2 headers or the B4X GoogleOAuth2 class to convert your JSON key to a Bearer token.
'    ' Once you have the AccessToken, proceed to CreateEditDraft.
'    
'    CreateEditDraft
'End Sub

' 2. Start a Google Play transactional edit session
Sub CreateEditDraft
	Log("Creating a new app edit session...")
	Dim job As HttpJob
	job.Initialize("CreateEdit", Me)
    
	Dim url As String = $"https://googleapis.com{PackageName}/edits"$
	job.PostString(url, "")
	job.GetRequest.SetHeader("Authorization", "Bearer " & AccessToken)
	job.GetRequest.SetContentType("application/json")
	Wait For (job) JobDone (job As HttpJob)
	If job.Success Then
		'assuming that the response is json:
		Dim root As Map = job.GetString.As(JSON).ToMap
		Log(root)
	End If
		
	Dim EditId As String = root.Get("id")
	UploadAAB(EditId)
End Sub

' 3. Stream the .aab file payload to Google
Sub UploadAAB (EditId As String)
	Log("Uploading App Bundle (.aab)...")
	Dim job As HttpJob
	job.Initialize("UploadBundle", Me)
    
	Dim url As String = $"https://googleapis.com{PackageName}/edits/${EditId}/bundles?uploadType=media"$
    
	' Stream the physical binary bundle file directly
	job.PostFile(url, File.GetFileParent(AabFilePath), File.GetName(AabFilePath))
	job.GetRequest.SetHeader("Authorization", "Bearer " & AccessToken)
	job.GetRequest.SetContentType("application/octet-stream")
	Wait For (job) JobDone (job As HttpJob)
	If job.Success Then
		'assuming that the response is json:
		Dim root As Map = job.GetString.As(JSON).ToMap
		Log(root)
		
		' You can extract the VersionCode here if needed
		Dim EditId As String = job.Tag ' Store/pass your tracking ID
		CommitChanges(EditId)		
	End If
End Sub

' 4. Finalize and push to track
Sub CommitChanges (EditId As String)
	Log("Committing release to Google Play...")
	Dim url As String = $"https://googleapis.com{PackageName}/edits/${EditId}:commit"$
	Dim job As HttpJob
	job.Initialize("CommitEdit", Me)
	job.PostString(url, "")
	job.GetRequest.SetContentType("application/json")
	job.GetRequest.SetHeader("Authorization", "Bearer " & AccessToken)
	
	Wait For (job) JobDone (job As HttpJob)
	If job.Success Then
		'assuming that the response is json:
		Dim root As Map = job.GetString.As(JSON).ToMap
		Log(root)
		Log("Success! AAB published successfully.")
		StopMessageLoop
		ExitApplication
	Else
		Log("Error occurred: " & job.ErrorMessage)
		StopMessageLoop
		ExitApplication
	End If
	job.Release
End Sub

